  "compiledShaders": [
    {
      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\nattribute vec2 a_uv0;\nvarying vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\n#extension GL_OES_standard_derivatives: enable\nprecision highp float;\nuniform vec4 cc_time;\n#if USE_ALPHA_TEST\n#endif\nvarying vec4 v_color;\n#if USE_TEXTURE\nvarying vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform vec4 i_color1;\nuniform vec4 i_color2;\nuniform vec4 i_color3;\nuniform vec4 i_outlineColor;\nuniform vec4 i_shadowColor;\nuniform vec4 i_bloomColor;\nuniform vec2 i_shadowOffset;\nuniform vec2 i_bloomDepth;\nuniform float i_gradient;\nuniform float i_bold;\nuniform float i_outlineBold;\nuniform float i_outline;\nuniform float i_shadow;\nuniform float i_bloom;\nuniform float i_bloomSpeed;\nvoid mix1(inout vec4 c, inout float a, vec4 c1, float a1) {\n    c.rgb = mix(c1, c, a).rgb;\n    c.a += (1. - a) * a1 * c1.a;\n    a += (1. - a) * a1;\n}\nvoid mix2(inout vec4 c, vec4 c1, float a1) {\n    c.rgb = mix(c1, c, c.a).rgb;\n    c.a += (1. - c.a) * a1 * c1.a;\n}\nfloat transAlpha(float alpha, float w, float s) {\n  float a = smoothstep(w - s, w + s, alpha);\n  return a;\n}\nvoid main () {\n  vec4 o = vec4(0);\n  float oa = 1.;\n  float s = 250.*dFdx(v_uv0).x;\n  vec4 c = texture2D(texture, v_uv0);\n  float a = c.a;\n  vec4 c1 = i_color1;\n  if(i_gradient > 1.5) {\n    c1 = step(c.r, 0.5) * mix(i_color1, i_color2, c.r * 2.0);\n    c1 += step(0.5, c.r) * mix(i_color2, i_color3, (c.r - 0.5) * 2.0);\n  }\n  else if(i_gradient > 0.5) {\n    c1 = mix(i_color1, i_color2, c.r);\n  }\n  float w1 = i_bold;\n  float a1 = transAlpha(a, w1, s);\n  o.rgb = c1.rgb;\n  o.a = a1 * c1.a;\n  oa = a1;\n  if(i_outline > 0.5) {\n    vec4 c2 = i_outlineColor;\n    float w2 = i_outlineBold;\n    float a2 = transAlpha(a, w2, s);\n    mix1(o, oa, c2, a2);\n  }\n  if(i_shadow > 0.5) {\n    vec4 c3 = i_shadowColor;\n    float w3 = min(i_bold, i_outlineBold);\n    float a3 = transAlpha(texture2D(texture, v_uv0 + i_shadowOffset).a, w3, s);\n    mix1(o, oa, c3, a3);\n  }\n  if(i_bloom > 0.5) {\n    vec4 c4 = i_bloomColor;\n    float w4 = 0.5;\n    float t4 = i_bloomDepth.x + (sin(cc_time.x * i_bloomSpeed - 1.570796) + 1.) * 0.25 * (i_bloomDepth.y - i_bloomDepth.x);\n    float a4 = smoothstep(.0, w4, a) * smoothstep(.0, w4, (1. - a)) * t4;\n    mix2(o, c4, a4);\n  }\n  o *= v_color;\n  gl_FragColor = o;\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nout vec4 v_color;\n#if USE_TEXTURE\nin vec2 a_uv0;\nout vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\n#extension GL_OES_standard_derivatives: enable\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\n#if USE_ALPHA_TEST\n  uniform ALPHA_TEST {\n    float alphaThreshold;\n  };\n#endif\nin vec4 v_color;\n#if USE_TEXTURE\nin vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform UARGS {\n  vec4 i_color1;\n  vec4 i_color2;\n  vec4 i_color3;\n  vec4 i_outlineColor;\n  vec4 i_shadowColor;\n  vec4 i_bloomColor;\n  vec2 i_shadowOffset;\n  vec2 i_bloomDepth;\n  float i_gradient;\n  float i_bold;\n  float i_outlineBold;\n  float i_outline;\n  float i_shadow;\n  float i_bloom;\n  float i_bloomSpeed;\n};\nvoid mix1(inout vec4 c, inout float a, vec4 c1, float a1) {\n    c.rgb = mix(c1, c, a).rgb;\n    c.a += (1. - a) * a1 * c1.a;\n    a += (1. - a) * a1;\n}\nvoid mix2(inout vec4 c, vec4 c1, float a1) {\n    c.rgb = mix(c1, c, c.a).rgb;\n    c.a += (1. - c.a) * a1 * c1.a;\n}\nfloat transAlpha(float alpha, float w, float s) {\n  float a = smoothstep(w - s, w + s, alpha);\n  return a;\n}\nvoid main () {\n  vec4 o = vec4(0);\n  float oa = 1.;\n  float s = 250.*dFdx(v_uv0).x;\n  vec4 c = texture2D(texture, v_uv0);\n  float a = c.a;\n  vec4 c1 = i_color1;\n  if(i_gradient > 1.5) {\n    c1 = step(c.r, 0.5) * mix(i_color1, i_color2, c.r * 2.0);\n    c1 += step(0.5, c.r) * mix(i_color2, i_color3, (c.r - 0.5) * 2.0);\n  }\n  else if(i_gradient > 0.5) {\n    c1 = mix(i_color1, i_color2, c.r);\n  }\n  float w1 = i_bold;\n  float a1 = transAlpha(a, w1, s);\n  o.rgb = c1.rgb;\n  o.a = a1 * c1.a;\n  oa = a1;\n  if(i_outline > 0.5) {\n    vec4 c2 = i_outlineColor;\n    float w2 = i_outlineBold;\n    float a2 = transAlpha(a, w2, s);\n    mix1(o, oa, c2, a2);\n  }\n  if(i_shadow > 0.5) {\n    vec4 c3 = i_shadowColor;\n    float w3 = min(i_bold, i_outlineBold);\n    float a3 = transAlpha(texture2D(texture, v_uv0 + i_shadowOffset).a, w3, s);\n    mix1(o, oa, c3, a3);\n  }\n  if(i_bloom > 0.5) {\n    vec4 c4 = i_bloomColor;\n    float w4 = 0.5;\n    float t4 = i_bloomDepth.x + (sin(cc_time.x * i_bloomSpeed - 1.570796) + 1.) * 0.25 * (i_bloomDepth.y - i_bloomDepth.x);\n    float a4 = smoothstep(.0, w4, a) * smoothstep(.0, w4, (1. - a)) * t4;\n    mix2(o, c4, a4);\n  }\n  o *= v_color;\n  gl_FragColor = o;\n}"
