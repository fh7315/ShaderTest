  "uuid": "a50d43f9-898a-43a9-b209-d1df57e30440",
  "compiledShaders": [
    {
      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\nattribute vec2 a_uv0;\nvarying vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n#endif\nvarying vec4 v_color;\n#if USE_TEXTURE\nvarying vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform vec4 i_color;\nuniform vec4 i_uvOffset;\nuniform vec2 i_resolution;\nuniform float i_uvRotated;\nuniform float i_radian;\nuniform float i_width;\nvec2 transUV(vec2 p) {\n  vec2 uv;\n  uv.x = (p.x - i_uvOffset.x) / (i_uvOffset.z - i_uvOffset.x);\n  uv.y = (p.y - i_uvOffset.y) / (i_uvOffset.w - i_uvOffset.y);\n  if(i_uvRotated > 0.5) {\n      float temp = uv.x;\n      uv.x = uv.y;\n      uv.y = 1.0 - temp;\n  }\n  return uv;\n}\nvec2 reverseTransUV(vec2 p) {\n  vec2 tp = p;\n  if(i_uvRotated > 0.5) {\n      tp.y = p.x;\n      tp.x = 1.0 - p.y;\n  }\n  vec2 uv;\n  uv.x = tp.x * (i_uvOffset.z - i_uvOffset.x) + i_uvOffset.x;\n  uv.y = tp.y * (i_uvOffset.w - i_uvOffset.y) + i_uvOffset.y;\n  return uv;\n}\nconst float PI = 3.14159265;\nvoid main () {\n  vec2 uv = transUV(v_uv0);\n  uv.x = uv.x-.5;\n  uv.y = .5-uv.y;\n  vec4 c0 = texture2D(texture, v_uv0);\n  float s0 = PI*0.2;\n  float s1 = PI*0.5;\n  float rad = i_radian;\n  vec2 ruv = vec2(uv.x*cos(rad)-uv.y*sin(rad), uv.x*sin(rad)+uv.y*cos(rad));\n  float ss = atan(ruv.y/ruv.x);\n  float al = smoothstep(s0, s1, abs(ss));\n  vec2 tuv = uv;\n  tuv.x *= 1.+i_width;\n  tuv.y *= 1.+i_width*i_resolution.x/i_resolution.y;\n  float tmp = step(abs(tuv.x), 0.5)*step(abs(tuv.y), 0.5);\n  tuv.x = tuv.x+.5;\n  tuv.y = .5-tuv.y;\n  tuv = reverseTransUV(tuv);\n  float at = texture2D(texture, tuv).a*tmp;\n  al *= step(at, 0.9);\n  al *= (1.-at);\n  vec4 cl = vec4(i_color.rgb, at);\n  vec4 o = mix(c0, cl, al);\n  o.a = c0.a;\n  o.a *= v_color.a;\n  gl_FragColor = o;\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nout vec4 v_color;\n#if USE_TEXTURE\nin vec2 a_uv0;\nout vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n  uniform ALPHA_TEST {\n    float alphaThreshold;\n  };\n#endif\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nin vec4 v_color;\n#if USE_TEXTURE\nin vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform UARGS {\n  vec4 i_color;\n  vec4 i_uvOffset;\n  vec2 i_resolution;\n  float i_uvRotated;\n  float i_radian;\n  float i_width;\n};\nvec2 transUV(vec2 p) {\n  vec2 uv;\n  uv.x = (p.x - i_uvOffset.x) / (i_uvOffset.z - i_uvOffset.x);\n  uv.y = (p.y - i_uvOffset.y) / (i_uvOffset.w - i_uvOffset.y);\n  if(i_uvRotated > 0.5) {\n      float temp = uv.x;\n      uv.x = uv.y;\n      uv.y = 1.0 - temp;\n  }\n  return uv;\n}\nvec2 reverseTransUV(vec2 p) {\n  vec2 tp = p;\n  if(i_uvRotated > 0.5) {\n      tp.y = p.x;\n      tp.x = 1.0 - p.y;\n  }\n  vec2 uv;\n  uv.x = tp.x * (i_uvOffset.z - i_uvOffset.x) + i_uvOffset.x;\n  uv.y = tp.y * (i_uvOffset.w - i_uvOffset.y) + i_uvOffset.y;\n  return uv;\n}\nconst float PI = 3.14159265;\nvoid main () {\n  vec2 uv = transUV(v_uv0);\n  uv.x = uv.x-.5;\n  uv.y = .5-uv.y;\n  vec4 c0 = texture2D(texture, v_uv0);\n  float s0 = PI*0.2;\n  float s1 = PI*0.5;\n  float rad = i_radian;\n  vec2 ruv = vec2(uv.x*cos(rad)-uv.y*sin(rad), uv.x*sin(rad)+uv.y*cos(rad));\n  float ss = atan(ruv.y/ruv.x);\n  float al = smoothstep(s0, s1, abs(ss));\n  vec2 tuv = uv;\n  tuv.x *= 1.+i_width;\n  tuv.y *= 1.+i_width*i_resolution.x/i_resolution.y;\n  float tmp = step(abs(tuv.x), 0.5)*step(abs(tuv.y), 0.5);\n  tuv.x = tuv.x+.5;\n  tuv.y = .5-tuv.y;\n  tuv = reverseTransUV(tuv);\n  float at = texture2D(texture, tuv).a*tmp;\n  al *= step(at, 0.9);\n  al *= (1.-at);\n  vec4 cl = vec4(i_color.rgb, at);\n  vec4 o = mix(c0, cl, al);\n  o.a = c0.a;\n  o.a *= v_color.a;\n  gl_FragColor = o;\n}"
