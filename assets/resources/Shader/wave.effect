CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        alphaThreshold: { value: 0.5 }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
    v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;
  
  #include <cc-global>
  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  #endif

  vec2 rand2D(vec2 n){
    return fract(sin(vec2(dot(n, vec2(12.9898, 4.1414)))));
  }

  float voronoi2D(vec2 n, float time){
    float dis = 0.9;
    for(float y = 0.0; y <= 1.0; y++){
      for(float x = 0.0; x <= 1.0; x++){
        // Neighbor place in the grid
        vec2 p = floor(n) + vec2(x, y);
        float d = length((0.27 * sin(rand2D(p) * 8.0 + time * 2.0)) + vec2(x, y) - fract(n));
        dis = min(dis, d);
      }
    }
    return dis;
  }

  void main(){
    vec3 color = vec3(1.0);
    float density = 6.0; //密度
    float ratio = 1.6; //横纵密度比
    float dis = 0.035; //扰动

    vec2 uv = v_uv0;
    float t = cc_time.x;
    vec3 texA = texture2D(texture, uv).rgb;

    vec2 base = uv;
    uv.x *= ratio;
    uv.x += sin(t * 3.2 + base.x * 2.0 + base.y * 16.0) * dis;
    uv.y += sin(t * 2.4 + base.x * 12.0 + base.y * 2.0) * dis;
    
    float v = clamp((pow(voronoi2D(uv * density, t), 6.0) * 2.0) + 0.25, 0.0, 1.0);

    texA = texture2D(texture, vec2(base.x + step(.0, base.x) * pow(v * 0.3, 2.0),  base.y)).rgb;
    
    vec4 o = vec4(color * pow(v, 3.0) + texA, 1.0);
    // vec4 o = vec4(texA, 1.0);
    
    o *= v_color;
    gl_FragColor = o;
  }
}%
