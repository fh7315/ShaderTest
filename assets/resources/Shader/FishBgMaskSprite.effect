CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        textureTide: { value: white }
        alphaThreshold: { value: 0.5 }
        outSize: { value: 0 }
        useTide: { value: 1 }
        useBlur: { value: 0 }
}%


CCProgram vs %{
  precision lowp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
    v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision lowp float;
  
  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  uniform sampler2D textureTide;
  #endif

  uniform UARGS {
    float outSize;
    float useTide;
    float useBlur;
  };
  
  const float R = 2.;
  const vec2 size = vec2(333., 185.);

  vec4 getBlurColor() {
    vec4 color = vec4(.0); //初始颜色
    float sum = .0; //总权重
    vec2 uv = v_uv0;
    // uv.x = floor(uv.x*size.x)/size.x;
    // uv.y = floor(uv.y*size.y)/size.y;
    for (float r = -R; r <= R; r++) {
      for (float c = -R; c <= R; c++) {
        vec2 t = vec2(r/1.3/size.x, c/1.3/size.y);
        // t.x = floor(t.x*size.x)/size.x;
        // t.y = floor(t.y*size.y)/size.y;
        vec2 p = uv + t; //目标像素位置
        float weight = (R-abs(r))*(R-abs(c)); //目标像素计算权重
        vec4 cc = p.x > useTide ? texture2D(textureTide, p-vec2(useTide, .0)) : texture2D(texture, p);
        color += weight*cc;
        sum += weight;
      }
    }
    color /= sum; //求出平均值
    return color;
  }

  void main() {
    float os = 0.5-outSize;
    float d = 0.02;
    vec2 p = vec2(abs(.5-v_uv0.x), abs(.5-v_uv0.y));
    vec4 color = vec4(.0);
    if(p.x > os+d*os || p.y > os) {
      color = useBlur > .5 ? getBlurColor() : texture2D(texture, v_uv0);
      color.a = 1.;
    }
    color.a *= v_color.a;
    gl_FragColor = color;
  }
}%
