CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        alphaThreshold: { value: 0.5 }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
    v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  #extension GL_OES_standard_derivatives: enable
  precision highp float;
  
  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  #endif

  float gray(vec4 c) {
    return 0.299*c.r + 0.587*c.g + 0.114*c.b;
  }

  float black(vec4 c) {
    return 0.2126*c.r + 0.7152*c.g + 0.0722 *c.b;
  }
  
  vec4 blur(vec2 uv) {
    vec4 color = vec4(.0); //初始颜色
    float sum = .0; //总权重
    const float R = 3.;
    float Rs = dFdx(uv).x * 3.;
    // float Rs = 0.005;
    for (float r = -R; r <= R; r++) {
      for (float c = -R; c <= R; c++) {
        vec2 p = uv + vec2(r*Rs, c*Rs); //目标像素位置
        float weight = (R-abs(r))*(R-abs(c)); //目标像素计算权重
        vec4 cc = texture2D(texture, p);
        color += weight*cc;
        sum += weight;
      }
    }
    color /= sum; //求出平均值
    return color;
  }

  void main () {

    /*vec4 c = texture2D(texture, v_uv0);
    float d = 0.001;
    float M = gray(c);
    float N = gray(texture2D(texture, v_uv0-vec2(d, .0)));
    float E = gray(texture2D(texture, v_uv0+vec2(d, .0)));
    float W = gray(texture2D(texture, v_uv0+vec2(.0, d)));
    float S = gray(texture2D(texture, v_uv0-vec2(.0, d)));

    float maxLuma = max(N, max(E, max(W, max(S, M))));
    float minLuma = min(N, min(E, min(W, min(S, M))));
    float constars = maxLuma - minLuma;

    if(constars > 0.03) {
      c.rgb = vec3(.0);
    }*/

    /*vec4 c = texture2D(texture, v_uv0);
    float d = 0.02;
    float M = c.a;
    float N = texture2D(texture, v_uv0-vec2(d, .0)).a;
    float E = texture2D(texture, v_uv0+vec2(d, .0)).a;
    float W = texture2D(texture, v_uv0+vec2(.0, d)).a;
    float S = texture2D(texture, v_uv0-vec2(.0, d)).a;
    
    float maxLuma = max(N, max(E, max(W, S)));
    if(M < 0.5 && maxLuma > 0.5) {
      c = vec4(1., .0, .0, maxLuma);
    }*/

    /*vec4 c = texture2D(texture, v_uv0);
    c.r = abs(c.g*2. - c.b) * c.r;
    c.g = abs(c.b*2. - c.r) * c.g;
    c.b = abs(c.r*2. - c.g) * c.b;*/

    vec4 c = texture2D(texture, v_uv0);
    c.rgb = vec3(black(c));
    vec4 cb = blur(v_uv0);

    gl_FragColor = cb;
  }
}%
