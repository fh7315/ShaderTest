  "uuid": "9f8cf5ae-65a5-46a0-9a12-42345186317f",
  "compiledShaders": [
    {
      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\nattribute vec2 a_uv0;\nvarying vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n#endif\nvarying vec4 v_color;\n#if USE_TEXTURE\nvarying vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform vec4 u_uvOffset;\nuniform float u_uvRotated;\nvec2 uvNormalize(vec2 p) {\n  vec2 uv;\n  uv.x = (p.x - u_uvOffset.x) / (u_uvOffset.z - u_uvOffset.x);\n  uv.y = (p.y - u_uvOffset.y) / (u_uvOffset.w - u_uvOffset.y);\n  if(u_uvRotated > 0.5) {\n      float temp = uv.x;\n      uv.x = uv.y;\n      uv.y = 1.0 - temp;\n  }\n  return uv;\n}\nvoid main () {\n  vec4 c = texture2D(texture, v_uv0);\n  if(uvNormalize(v_uv0).y > .5) c.a = 0.3;\n  gl_FragColor = c;\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nout vec4 v_color;\n#if USE_TEXTURE\nin vec2 a_uv0;\nout vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n  uniform ALPHA_TEST {\n    float alphaThreshold;\n  };\n#endif\nin vec4 v_color;\n#if USE_TEXTURE\nin vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform UARGS {\n  vec4 u_uvOffset;\n  float u_uvRotated;\n};\nvec2 uvNormalize(vec2 p) {\n  vec2 uv;\n  uv.x = (p.x - u_uvOffset.x) / (u_uvOffset.z - u_uvOffset.x);\n  uv.y = (p.y - u_uvOffset.y) / (u_uvOffset.w - u_uvOffset.y);\n  if(u_uvRotated > 0.5) {\n      float temp = uv.x;\n      uv.x = uv.y;\n      uv.y = 1.0 - temp;\n  }\n  return uv;\n}\nvoid main () {\n  vec4 c = texture2D(texture, v_uv0);\n  if(uvNormalize(v_uv0).y > .5) c.a = 0.3;\n  gl_FragColor = c;\n}"
      }
